{
  "workflowApiVersion": "1.1",
  "type": "REST",
  "metaData": {
    "icon": "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQWejx1A1AUS1FgggjfcC-4iUXMg7C-GaJdrQ&s",
    "category": "custom"
  },
  "lang": {
    "en-US": {
      "name": "Journey Entry Logger",
      "description": "Logs journey entry into system"
    }
  },
  "arguments": {
    "execute": {
      "url": "https://simplediy-1.onrender.com/execute",
      "verb": "POST",
      "useJwt": false,
      "inArguments": [
        { "SubscriberKey": "{{Contact.Key}}" },
        { "Email": "{{Contact.Default.Email}}" },
        { "JourneyId": "{{Interaction.Id}}" },
        { "JourneyName": "{{Interaction.Name}}" }
      ]
    }
  },
  "configurationArguments": {
    "publish": {
      "url": "https://simplediy-1.onrender.com/publish"
    },
    "validate": {
      "url": "https://simplediy-1.onrender.com/validate"
    },
    "stop": {
      "url": "https://simplediy-1.onrender.com/stop"
    }
  },
  "userInterfaces": {
    "configModal": {
      "url": "https://simplediy-1.onrender.com/ui.html",
      "height": 400,
      "width": 600
    }
  },
  "schema": {
    "arguments": {
      "execute": {
        "inArguments": [],
        "outArguments": []
      }
    }
  }
}
